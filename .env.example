# Copy to `.env` for local overrides (`.env` is gitignored).
# Demo credentials below are for local lab only — never use in real prod.

POSTGRES_USER=mtsd
POSTGRES_PASSWORD=mtsd
POSTGRES_DB=mtsd

# Host-side app talking to published postgres port:
# APP_DATABASE__URL=postgresql://mtsd:mtsd@127.0.0.1:5433/mtsd

# Inside compose network the app uses service DNS + container port 5432
# (set in docker-compose.yml). Override if needed:
# APP_DATABASE__URL=postgresql://mtsd:mtsd@postgres:5432/mtsd

APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# MLflow homework stack (Compose sets the in-network URL automatically).
# For a host-side uvicorn process use http://127.0.0.1:5000.
# APP_MLFLOW__TRACKING_URI=http://127.0.0.1:5000
APP_MLFLOW__MODEL_NAME=mtsd20-detector
APP_MLFLOW__MODEL_ALIAS=champion

# HW4 FastStream/RabbitMQ pipeline. Compose sets the in-network host by default.
# Compose uses rabbitmq service DNS; for host-side uv run use 127.0.0.1:5672.
# APP_RABBIT__URL=amqp://guest:guest@127.0.0.1:5672/
APP_RABBIT__QUEUE_NAME=mtsd.tasks.pending
APP_RABBIT__BOUNDED_QUEUE=true
APP_RABBIT__QUEUE_MAX_LENGTH=8
APP_RABBIT__PREFETCH_COUNT=2
APP_RABBIT__WORKER_CONCURRENCY=2
APP_RABBIT__MAX_RETRIES=2
APP_RABBIT__INFERENCE_DELAY_S=0.25

MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW_POSTGRES_DB=mlflow
