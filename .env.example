# Copy to `.env` for local overrides (`.env` is gitignored).
# Demo credentials below are for local lab only — never use in real prod.

POSTGRES_USER=mtsd
POSTGRES_PASSWORD=mtsd
POSTGRES_DB=mtsd

# Host-side app talking to published postgres port:
# APP_DATABASE__URL=postgresql://mtsd:mtsd@127.0.0.1:5433/mtsd

# Inside compose network the app uses service DNS + container port 5432
# (set in docker-compose.yml). Override if needed:
# APP_DATABASE__URL=postgresql://mtsd:mtsd@postgres:5432/mtsd

APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
